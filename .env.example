# StoryCraft 环境变量
# 复制此文件为 .env：cp .env.example .env
#
# API 密钥通过页面设置（登录 → 设置 → 填写密钥），不在这里配置
# JWT_SECRET 和 ENCRYPTION_KEY 首次启动时自动生成
#
# 所以这个文件可以是空的，所有值都会自动生成

# JWT_SECRET=              # (自动生成) 用户认证签名密钥
# ENCRYPTION_KEY=          # (自动生成) API Key 加密存储密钥

# ── 前端生产部署 ────────────────────────────
# 本地开发时不需要设置，前端默认连接 http://localhost:3001
#
# 部署到云服务器时，在服务器上编辑 apps/web/.env.production：
#   VITE_API_URL=http://你的服务器IP:3001
